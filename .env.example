# Supabase (publishable/anon key only — safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in Server Actions /
# Edge Functions for privileged operations (e.g. admin moderation actions).
# Do not read this in any file that ships to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Supabase Auth providers, not used directly here)
# NEXT_PUBLIC_SITE_URL is used to build redirect URLs for auth flows.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
# xBloom does not currently expose a public API/OAuth integration. This flag
# must stay false until an official partnership/API exists — see
# src/lib/integrations/xbloom.ts and docs/architecture.md.
NEXT_PUBLIC_XBLOOM_DIRECT_SYNC_ENABLED=false
