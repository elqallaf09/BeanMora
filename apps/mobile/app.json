{
  "expo": {
    "name": "BeanMora",
    "slug": "beanmora-mobile",
    "owner": "elqallaf09",
    "version": "0.5.14",
    "scheme": "beanmora",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F2E9",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beanmora.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "8"
    },
    "android": {
      "package": "com.beanmora.mobile",
      "versionCode": 24,
      "icon": "./assets/brand/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#F7F2E9"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "a3785113-b993-49fa-9986-e3dc96d63115"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
