{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "navigation-test": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "sdk-57"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "ios": {
        "image": "sdk-57"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819935215"
      }
    }
  }
}
