{
  "name": "beanmora-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "tunnel": "expo start --go --tunnel",
    "setup": "node scripts/setup.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/sync-core.mjs --check && node scripts/check-mobile.mjs",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "expo": "57.0.24",
    "expo-crypto": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
